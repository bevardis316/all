#!/bin/sh
#
# Gradle startup script for POSIX-compatible shells
#

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Resolve APP_HOME from the script's actual location (follow symlinks)
app_path=$0
while [ -h "$app_path" ]; do
    ls_out=$(ls -ld "$app_path")
    link=${ls_out#*' -> '}
    case $link in
        /*) app_path=$link ;;
        *)  app_path="${app_path%/*}/$link" ;;
    esac
done
APP_HOME=$(cd "${app_path%/*}/." > /dev/null && pwd -P) || exit

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

warn() { echo "$*"; }
die()  { echo; echo "$*"; echo; exit 1; }

# Determine java command
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
    [ -x "$JAVACMD" ] || die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
else
    JAVACMD="java"
    command -v java > /dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command found in PATH."
fi

# Increase file descriptors if possible
MAX_FD=$(ulimit -H -n 2>/dev/null)
[ "$MAX_FD" ] && ulimit -n "$MAX_FD" 2>/dev/null

set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

eval "set -- $(
    printf '%s\n' "$DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS" |
    xargs -n1 |
    sed 's~[^-[:alnum:]+,./:=@_]~\\&~g;' |
    tr '\n' ' '
)" '"$@"'

exec "$JAVACMD" "$@"
